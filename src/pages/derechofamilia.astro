---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';

import { supabase } from '../lib/supabaseClient.js';
const { data } = await supabase.auth.getSession();
const session = data.session;

---

<Layout title="Lexpert IA - Derecho de Familia">
  <Navigation showBackButton={true} 
    showLoginButton={true} />
  
  <main class="chat-page">

    <header class="page-header">
      <h1>Derecho de Familia</h1>
    </header>

    <section id="chat-content" class="chat-container">
        <!-- Contenedor del chat -->

    </section>

    <div style="flex-shrink:0; height:4rem;"></div>

    <footer class="corporate-info">
      <p>© 2025 Lexpert IA. Todos los derechos reservados.</p>
      <p></p>
    </footer>

  </main>
</Layout>

<script type="module">
import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';

const supabaseUrl = 'https://qqqnidhebjcsjzcgbhzr.supabase.co';
const supabaseAnonKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFxcW5pZGhlYmpjc2p6Y2diaHpyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTgxNjcyMzIsImV4cCI6MjA3Mzc0MzIzMn0.O6wOJ6IiwKORDWZ0wAtgDfe9z6_BnjN87J07kmMTb-M';
const supabase = createClient(supabaseUrl, supabaseAnonKey);

const chatContent = document.getElementById('chat-content');

async function checkSession() {
  const { data: { session } } = await supabase.auth.getSession();

  if (session) {
    chatContent.innerHTML = `
      <h1>Bienvenido al Chat</h1>
      <p>Solo usuarios logueados pueden ver esto.</p>
      <p>Email: ${session.user.email}</p>
    `;
  } else {
    chatContent.innerHTML = `
      <h2 class="text-2xl font-bold">Debes iniciar sesión para acceder a este contenido.</h2>
      <p>Haz clic en <strong>"Iniciar sesión"</strong> en el menú superior para continuar.</p>
    `;
  }
}

// Ejecutar al cargar la página
checkSession();

// Escuchar cambios de sesión en tiempo real
supabase.auth.onAuthStateChange((_event, session) => {
  checkSession();
});
</script>

<style>
.chat-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  color: #f5f5f7;
  background: #000;
}

.page-header {
  text-align: center;
  padding: 4rem 1rem 2rem;
}

.page-header h1 {
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 700;
  background: linear-gradient(135deg, #fff, #86868b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin: 0;
}

.chat-container {
  flex: 1;
  padding: 2rem;
  margin: 0 auto;
  max-width: 1200px;
  width: 100%;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
}

.corporate-info {
  text-align: center;
  padding: 2rem 1rem;
  font-size: 0.875rem;
  color: #86868b;
  background: #111;
}
</style>
