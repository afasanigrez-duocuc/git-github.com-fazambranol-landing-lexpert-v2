---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="Lexpert IA - Derecho Tributario">
  <Navigation showBackButton={true} />
  
  <main class="chat-page">

    <header class="page-header">
      <h1>Derecho Tributario</h1>
    </header>

    <section class="chat-container">
        <!-- Contenedor del chat -->
    </section>

    <div style="flex-shrink:0; height:4rem;"></div>

    <footer class="corporate-info">
      <p>© 2025 Lexpert IA. Todos los derechos reservados.</p>
      <p></p>
    </footer>

  </main>
</Layout>

<style>
.chat-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  color: #f5f5f7;
  background: #000;
}

.page-header {
  text-align: center;
  padding: 4rem 1rem 2rem;
}

.page-header h1 {
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 700;
  background: linear-gradient(135deg, #fff, #86868b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin: 0;
}

.chat-container {
  flex: 1;
  padding: 2rem;
  margin: 0 auto;
  max-width: 1200px;
  width: 100%;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
}

.corporate-info {
  text-align: center;
  padding: 2rem 1rem;
  font-size: 0.875rem;
  color: #86868b;
  background: #111;
}
</style>
