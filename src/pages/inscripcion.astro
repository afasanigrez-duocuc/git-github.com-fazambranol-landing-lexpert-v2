---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import { createClient } from '@supabase/supabase-js';

interface Props {
  plan?: string;
}

const urlParams = new URLSearchParams(Astro.request.url.split('?')[1]);
const plan = urlParams.get('plan') || 'Tu plan';

const supabaseUrl = 'https://your-supabase-url.supabase.co';
const supabaseKey = 'your-anon-key';
const supabase = createClient(supabaseUrl, supabaseKey);
---

<Layout title={`Inscripción - ${plan}`}>
  <Navigation showBackButton={true} />
  
  <main>
    <section class="signup">
      <h2>Inscribirse al plan: {plan}</h2>
      <p>Completa tus datos para comenzar tu suscripción.</p>

      <form class="signup-form" id="signup-form">
        <label>
          Nombre:
          <input type="text" name="name" required />
        </label>

        <label>
          Email:
          <input type="email" name="email" required />
        </label>

        <button type="submit">Enviar inscripción</button>
      </form>

      <script>
        import { createClient } from '@supabase/supabase-js';

        const supabaseUrl = 'https://your-supabase-url.supabase.co';
        const supabaseKey = 'your-anon-key';
        const supabase = createClient(supabaseUrl, supabaseKey);

        const form = document.getElementById('signup-form') as HTMLFormElement;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const formData = new FormData(form);
          const name = formData.get('name');
          const email = formData.get('email');
          const plan = "{selectedPlan}"; 

          const { data, error } = await supabase
            .from('contracts')
            .insert([{ name, email, plan }]);

          if (error) {
            alert('Hubo un error al registrar: ' + error.message);
          } else {
            alert('¡Inscripción enviada con éxito!');
            form.reset();
          }
        });
      </script>

    </section>
  </main>
</Layout>

<style>
.signup {
  max-width: 600px;
  margin: 6rem auto 3rem;
  padding: 0 1rem;
  color: #fff;
  text-align: center;
}

.signup h2 {
  font-size: clamp(2rem, 5vw, 3rem);
  background: linear-gradient(135deg, #fff, #86868b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 1rem;
}

.signup p {
  margin-bottom: 2rem;
  color: #86868b;
}

form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

input {
  padding: 0.75rem;
  border-radius: 8px;
  border: none;
}

button {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 0.8rem 1.5rem;
  border-radius: 25px;
  color: #fff;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
}

button:hover {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.2);
}
</style>
