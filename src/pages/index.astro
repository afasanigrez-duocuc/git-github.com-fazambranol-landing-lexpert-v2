---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ProductCard from '../components/ProductCard.astro';
import Hero from '../components/Hero.astro';
import PricingSection from '../components/PricingSection.astro';
---

<Layout title="Lexpert IA">
	<Navigation showBackButton={false} showIndexButton={true} showLoginButton={true} />
	<main>
		<Hero />
		<section class="products" id="productos">
			<div class="section-header">
				<h2>Nuestros Chats</h2>
			</div>
			<div class="products-grid">

				<ProductCard
					title="Libre Competencia"
					description="Accede a la jurisprudencia del Tribunal de Defensa de la Libre Competencia y de la Fiscalía Nacional Económica, integrada con nuestra avanzada plataforma de búsqueda impulsada por IA."
					icon="⚖️"
					gradient="blue"
					href="/librecompetencia"
				/>

				<ProductCard
					title="Laudos Arbitrales"
					description="Explora nuestra extensa base de datos de laudos arbitrales del Centro de Arbitraje y Mediación, con análisis predictivo y búsqueda semántica."
					icon="📜"
					gradient="purple"
					href="/laudosarbitrales"

				/>

				<ProductCard
					title="Derecho Civil"
					description="Consulta la jurisprudencia civil de la Corte Suprema y las Cortes de Apelaciones de Chile, y accede a análisis detallados de sus casos relevantes."
					icon="📘"
					gradient="purple"
					href="/derechocivil"
				/>

				<ProductCard
					title="Derecho de Familia"
					description="Realiza consultas jurídicas sobre el derecho de familia chileno y revisa la jurisprudencia administrativa y judicial relacionada."
					icon="👨🏻‍🍼"
					gradient="purple"
					href="/derechofamilia"
				/>

				<ProductCard
					title="Derecho Tributario"
					description="Consulta nuestra base de datos de derecho tributario y accede a análisis detallados de casos relevantes y respuestas del Servicio de Impuestos Internos."
					icon="💵"
					gradient="purple"
					href="/derechotributario"
				/>

				<ProductCard
					title="Próximamente"
					description="¡Estamos trabajando en más soluciones para la industria legal!"
					icon="🚀"
					gradient="purple"
					comingSoon={true}

				/>

			</div>
		</section>
		
		<PricingSection />
	</main>
</Layout>

<style>
	main {
		margin: 0 auto;
		width: 100%;
		color: #f5f5f7;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-header h2 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		background: linear-gradient(135deg, #fff, #86868b);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.products, .coming-soon {
		padding: 6rem 1rem;
		background: #000;
	}

	.products-grid {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		padding: 0 1rem;
	}

	.coming-soon-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.blur-card {
		background: rgba(255, 255, 255, 0.05);
		border-radius: 20px;
		padding: 3rem 2rem;
		text-align: center;
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		transition: all 0.3s ease;
	}

	.blur-card:hover {
		transform: translateY(-5px);
		border-color: rgba(255, 255, 255, 0.2);
	}

	.gear-icon {
		width: 80px;
		height: 80px;
		margin: 0 auto 1.5rem;
		color: #60a5fa;
		animation: spin 10s linear infinite;
	}

	@keyframes spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.blur-card p {
		color: #86868b;
		font-size: 1.25rem;
		line-height: 1.6;
		max-width: 600px;
		margin: 0 auto;
	}

	@media (min-width: 768px) {
		.products-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>