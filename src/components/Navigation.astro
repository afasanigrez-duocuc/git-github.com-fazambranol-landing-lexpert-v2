export interface Props {
  showBackButton?: boolean;
  showIndexButton?: boolean;
  showLoginButton?: boolean;
}

const { showBackButton = false, showIndexButton = false, showLoginButton = false } = Astro.props;

supabase.auth.onAuthStateChange((event, session) => {
  console.log("Auth event:", event, session);
  if (session) {
    // Aquí puedes actualizar tu UI o guardar el usuario en un store
  }
});
---

<nav>
  <div class="nav-container">
    <a href="/#hero" class="logo">Lexpert AI</a>
    <div class="nav-actions">
      {showBackButton && (
        <a href="/#hero" class="back-button">Inicio</a>
      )}
      {showIndexButton && (
        <>
          <a href="/#productos" class="index-button">Chats</a>
          <a href="/#planes" class="index-button">Planes</a>
        </>
      )}
      {showLoginButton && (
        <>
          <a href="#" id="login-btn" class="index-button">Iniciar sesión</a>
        </>
      )}

    </div>
  </div>
</nav>

<div id="login-modal" class="modal">
  <div class="modal-content">
    <span class="close" id="close-modal">&times;</span>
    <h2 class="modal-title">Iniciar sesión</h2>
    <button id="google-login" class="google-btn">
      <span class="google-icon">
        <svg width="22" height="22" viewBox="0 0 48 48">
          <g>
            <path fill="#4285F4" d="M43.6 20.5h-1.9V20H24v8h11.3c-1.6 4.3-5.7 7.5-10.3 7.5-6.1 0-11-4.9-11-11s4.9-11 11-11c2.6 0 5 .9 6.9 2.4l6.1-6.1C36.1 7.6 30.4 5 24 5 12.9 5 4 13.9 4 25s8.9 20 20 20c11 0 20-8.9 20-20 0-1.3-.1-2.7-.4-4z"/>
            <path fill="#34A853" d="M6.3 14.1l6.6 4.8C15.2 16.1 19.3 13 24 13c2.6 0 5 .9 6.9 2.4l6.1-6.1C36.1 7.6 30.4 5 24 5c-7.2 0-13.4 4.1-16.7 10.1z"/>
            <path fill="#FBBC05" d="M24 44c6.1 0 11.2-2 14.9-5.4l-6.9-5.7c-2 1.4-4.5 2.2-8 2.2-4.6 0-8.7-3.2-10.3-7.5l-6.6 5.1C10.6 39.9 16.8 44 24 44z"/>
            <path fill="#EA4335" d="M43.6 20.5h-1.9V20H24v8h11.3c-1.1 3-3.6 5.5-6.9 6.7l6.9 5.7c4.1-3.8 6.7-9.4 6.7-15.9 0-1.3-.1-2.7-.4-4z"/>
          </g>
        </svg>
      </span>
      <span class="google-text">Continuar con Google</span>
    </button>
  </div>
</div>


<script type="module">
import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm';

const supabaseUrl = 'https://qqqnidhebjcsjzcgbhzr.supabase.co';
const supabaseAnonKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFxcW5pZGhlYmpjc2p6Y2diaHpyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTgxNjcyMzIsImV4cCI6MjA3Mzc0MzIzMn0.O6wOJ6IiwKORDWZ0wAtgDfe9z6_BnjN87J07kmMTb-M';
const supabase = createClient(supabaseUrl, supabaseAnonKey);

window.addEventListener('DOMContentLoaded', async () => {
  const btn = document.getElementById('login-btn');
  const modal = document.getElementById('login-modal');
  const close = document.getElementById('close-modal');
  const googleLogin = document.getElementById('google-login');

  if (!btn) {
    console.error('[login] no se encontró elemento #login-btn');
    return;
  }

  // Función que actualiza el estado del botón según si hay sesión
  function updateButton(session) {

    let existingDropdown = document.getElementById('logout-dropdown');
    if (existingDropdown) existingDropdown.remove();

    const btn = document.getElementById('login-btn');

    if (session) {
    // Usuario logueado -> mostrar email
    btn.textContent = session.user.email;
    btn.style.position = 'relative'; 

    // Crear dropdown
    const dropdown = document.createElement('div');
    dropdown.id = 'logout-dropdown';
    dropdown.style.position = 'absolute';
    dropdown.style.top = '100%';
    dropdown.style.right = '2.1rem';
    dropdown.style.background = '#1a1a1a';
    dropdown.style.color = '#fff';
    dropdown.style.padding = '0.5rem 1rem';
    dropdown.style.borderRadius = '0.5rem';
    dropdown.style.boxShadow = '0 4px 8px rgba(0,0,0,0.2)';
    dropdown.style.display = 'none';
    dropdown.style.whiteSpace = 'nowrap';
    dropdown.style.zIndex = '1000';
    dropdown.style.cursor = 'pointer';
    dropdown.textContent = 'Cerrar sesión';

    // Añadir al DOM
    btn.parentElement.appendChild(dropdown);

    // Mostrar/ocultar dropdown al hacer click en el email
    btn.onclick = (e) => {
      e.preventDefault();
      dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
    };

    // Cerrar sesión al hacer click en el dropdown
    dropdown.addEventListener('click', async (e) => {
      e.preventDefault();
      const { error } = await supabase.auth.signOut();
      if (error) console.error('signOut error', error);
      updateButton(null);
    });

    // Cerrar dropdown al hacer click fuera
    window.addEventListener('click', (e) => {
      if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.style.display = 'none';
      }
    });

    } else {
      // No hay sesión -> mostrar "Iniciar sesión" y abrir modal
      btn.textContent = 'Iniciar sesión';
      btn.onclick = (e) => {
        e?.preventDefault?.();
        if (modal) modal.style.display = 'flex';
      };
    }
  }

  // Obtenemos la sesión inicial correctamente (destructuring correcto)
  try {
    const { data: { session } = {} } = await supabase.auth.getSession();
    console.log('[login] sesión inicial:', session ?? 'ninguna');
    updateButton(session ?? null);
  } catch (err) {
    console.error('[login] error getSession', err);
    updateButton(null);
  }

  // Escuchamos cambios de sesión (login/logout)
  supabase.auth.onAuthStateChange((event, session) => {
    console.log('[login] onAuthStateChange', event, session);
    updateButton(session ?? null);
    if (session && modal) modal.style.display = 'none';
  });

  // Cerrar modal: botón X
  if (close) close.addEventListener('click', () => modal && (modal.style.display = 'none'));

  // Cerrar modal al hacer click fuera del contenido
  window.addEventListener('click', (e) => {
    if (e.target === modal) modal.style.display = 'none';
  });


  // Botón Login con Google
  if (googleLogin) {
  googleLogin.addEventListener('click', async (e) => {
    e.preventDefault();

    const isHome = window.location.pathname === '/' || window.location.pathname === '';
    const redirectTo = isHome ? window.location.origin : window.location.href;

    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo },
    });

    if (error) {
      console.error('[login] OAuth error', error);
      alert('Error al iniciar con Google: ' + error.message);
      return;
    }

    console.log('[login] OAuth iniciado, esperando sesión...');
  });
}

  // Escuchar cambios de sesión
  supabase.auth.onAuthStateChange(async (event, session) => {
  console.log('[login] onAuthStateChange', event, session);

  if (!session) {
    updateButton(null);
    return;
  }

  const email = session.user.email;

    // Verificamos si el email está registrado en beta_signups
    const { data: registered, error: queryError } = await supabase
      .from('beta_signups')
      .select('email')
      .eq('email', email)
      .single();

    if (queryError || !registered) {
      // Crear contenedor de mensaje
      const messageDiv = document.createElement('div');
      messageDiv.style.position = 'fixed';
      messageDiv.style.top = '40%';
      messageDiv.style.left = '50%';
      messageDiv.style.transform = 'translate(-50%, -50%)';
      messageDiv.style.padding = '1.5rem 2rem';
      messageDiv.style.background = 'rgba(50, 50, 50, 0.95)'; 
      messageDiv.style.color = '#fff';
      messageDiv.style.fontWeight = '700';
      messageDiv.style.fontSize = '1.2rem';
      messageDiv.style.border = '2px solid #fff';
      messageDiv.style.borderRadius = '12px';
      messageDiv.style.boxShadow = '0 8px 20px rgba(0,0,0,0.5)';
      messageDiv.style.zIndex = '10000';
      messageDiv.style.textAlign = 'center';

      // Texto de alerta
      const text = document.createElement('p');
      text.textContent = 'Primero debes completar el formulario';
      text.style.marginBottom = '1rem';
      messageDiv.appendChild(text);

      // Botón de registro
      const button = document.createElement('button');
      button.textContent = 'Registro';
      button.style.padding = '0.6rem 1.2rem';
      button.style.borderRadius = '8px';
      button.style.border = 'none';
      button.style.background = 'linear-gradient(135deg, #fff, #86868b)';
      button.style.color = '#000';
      button.style.fontWeight = '700';
      button.style.cursor = 'pointer';
      button.addEventListener('click', () => {
        // Redirigir al formulario
        window.location.href = `/inscripcion?email=${encodeURIComponent(email)}`;
      });
      messageDiv.appendChild(button);

      // Añadir al DOM
      document.body.appendChild(messageDiv);

      // Cerrar sesión temporalmente
      await supabase.auth.signOut();

      return;
    }

    // Usuario registrado: mostrar email con dropdown
    updateButton(session);
    if (modal) modal.style.display = 'none';

});


});
</script>


